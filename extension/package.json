{
  "name": "nebula-agent",
  "displayName": "Nebula Agent",
  "description": "Claude-powered agent for Nebula IDE: agent panel, Agent Manager, change review and Antigravity import.",
  "version": "1.4.0",
  "publisher": "nebula",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "nebula-agent",
          "title": "Agent",
          "icon": "media/spark.svg"
        }
      ]
    },
    "views": {
      "nebula-agent": [
        {
          "type": "webview",
          "id": "nebula.agentView",
          "name": "Agent",
          "icon": "media/spark.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nebula.focusAgent",
        "title": "Open Agent",
        "category": "Nebula"
      },
      {
        "command": "nebula.newConversation",
        "title": "New Conversation",
        "category": "Nebula",
        "icon": "$(add)"
      },
      {
        "command": "nebula.openAgentManager",
        "title": "Open Agent Manager",
        "category": "Nebula",
        "icon": "$(layout)"
      },
      {
        "command": "nebula.inlineEdit",
        "title": "Edit Selection with Agent",
        "category": "Nebula"
      },
      {
        "command": "nebula.signIn",
        "title": "Sign in with Claude",
        "category": "Nebula"
      },
      {
        "command": "nebula.signOut",
        "title": "Sign out of Claude",
        "category": "Nebula"
      },
      {
        "command": "nebula.setApiKey",
        "title": "Use Anthropic API Key",
        "category": "Nebula"
      },
      {
        "command": "nebula.importAntigravity",
        "title": "Import Extensions & Settings from Antigravity",
        "category": "Nebula"
      },
      {
        "command": "nebula.reviewChanges",
        "title": "Review Agent Changes",
        "category": "Nebula"
      },
      {
        "command": "nebula.acceptAll",
        "title": "Accept All Agent Changes",
        "category": "Nebula"
      },
      {
        "command": "nebula.rejectAll",
        "title": "Reject All Agent Changes",
        "category": "Nebula"
      },
      {
        "command": "nebula.history",
        "title": "Past Conversations",
        "category": "Nebula",
        "icon": "$(history)"
      },
      {
        "command": "nebula.moreOptions",
        "title": "Additional Options",
        "category": "Nebula",
        "icon": "$(ellipsis)"
      },
      {
        "command": "nebula.closeAgent",
        "title": "Close Agent",
        "category": "Nebula",
        "icon": "$(close)"
      },
      {
        "command": "nebula.selectModel",
        "title": "Select Model",
        "category": "Nebula"
      },
      {
        "command": "nebula.updateEngine",
        "title": "Check for Claude Engine Updates",
        "category": "Nebula"
      },
      {
        "command": "nebula.customizations",
        "title": "Customizations",
        "category": "Nebula"
      },
      {
        "command": "nebula.agentSettings",
        "title": "Agent Settings",
        "category": "Nebula"
      },
      {
        "command": "nebula.openUsage",
        "title": "Usage",
        "category": "Nebula",
        "icon": "$(pulse)"
      },
      {
        "command": "nebula.newProject",
        "title": "New Project",
        "category": "Nebula",
        "icon": "$(new-folder)"
      },
      {
        "command": "nebula.openProject",
        "title": "Open Project",
        "category": "Nebula",
        "icon": "$(folder-opened)"
      },
      {
        "command": "nebula.revealProjects",
        "title": "Show Projects Folder",
        "category": "Nebula"
      },
      {
        "command": "nebula.openSettings",
        "title": "Settings",
        "category": "Nebula",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nebula.importFrom",
        "title": "Import from Another Editor (Antigravity, VS Code, Cursor, Windsurf)",
        "category": "Nebula"
      },
      {
        "command": "nebula.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Nebula",
        "icon": "$(sparkle)"
      },
      {
        "command": "nebula.openBrowser",
        "title": "Open Browser",
        "category": "Nebula",
        "icon": "$(globe)"
      },
      {
        "command": "nebula.changelog",
        "title": "Open Changelog",
        "category": "Nebula"
      },
      {
        "command": "nebula.openMemory",
        "title": "Open Agent Memory",
        "category": "Nebula",
        "icon": "$(note)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nebula.newConversation",
          "when": "view == nebula.agentView",
          "group": "navigation@1"
        },
        {
          "command": "nebula.history",
          "when": "view == nebula.agentView",
          "group": "navigation@2"
        },
        {
          "command": "nebula.closeAgent",
          "when": "view == nebula.agentView",
          "group": "navigation@9"
        },
        {
          "command": "nebula.openAgentManager",
          "when": "view == nebula.agentView",
          "group": "1_agent@1"
        },
        {
          "command": "nebula.reviewChanges",
          "when": "view == nebula.agentView",
          "group": "1_agent@2"
        },
        {
          "command": "nebula.customizations",
          "when": "view == nebula.agentView",
          "group": "2_config@1"
        },
        {
          "command": "nebula.agentSettings",
          "when": "view == nebula.agentView",
          "group": "2_config@2"
        },
        {
          "command": "nebula.updateEngine",
          "when": "view == nebula.agentView",
          "group": "3_account@1"
        },
        {
          "command": "nebula.signOut",
          "when": "view == nebula.agentView",
          "group": "3_account@3"
        },
        {
          "command": "nebula.openUsage",
          "when": "view == nebula.agentView",
          "group": "1_agent@3"
        },
        {
          "command": "nebula.newProject",
          "when": "view == nebula.agentView",
          "group": "0_project@1"
        },
        {
          "command": "nebula.openProject",
          "when": "view == nebula.agentView",
          "group": "0_project@2"
        },
        {
          "command": "nebula.openSettings",
          "when": "view == nebula.agentView",
          "group": "2_config@0"
        },
        {
          "command": "nebula.openBrowser",
          "when": "view == nebula.agentView",
          "group": "1_agent@4"
        },
        {
          "command": "nebula.importFrom",
          "when": "view == nebula.agentView",
          "group": "3_account@2"
        },
        {
          "command": "nebula.openMemory",
          "when": "view == nebula.agentView",
          "group": "2_config@3"
        }
      ],
      "editor/context": [
        {
          "command": "nebula.focusAgent",
          "when": "editorHasSelection",
          "group": "navigation@0"
        },
        {
          "command": "nebula.inlineEdit",
          "when": "editorHasSelection",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "nebula.closeAgent",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "nebula.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@-1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nebula.focusAgent",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "nebula.openAgentManager",
        "key": "ctrl+e",
        "mac": "cmd+e"
      },
      {
        "command": "nebula.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "nebula.newConversation",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "configuration": {
      "title": "Nebula Agent",
      "properties": {
        "nebula.model": {
          "type": "string",
          "default": "opus",
          "description": "Model used by the agent: a Claude model, or \"<provider>::<model>\" for other providers."
        },
        "nebula.conversationMode": {
          "type": "string",
          "default": "planning",
          "enum": [
            "planning",
            "fast"
          ],
          "enumDescriptions": [
            "Agent plans with a task list before acting — best for larger work.",
            "Agent acts directly — best for quick tasks."
          ]
        },
        "nebula.reviewPolicy": {
          "type": "string",
          "default": "agentDecides",
          "enum": [
            "alwaysProceed",
            "agentDecides",
            "requestReview"
          ],
          "enumItemLabels": [
            "Always Proceed",
            "Agent Decides",
            "Request Review"
          ],
          "description": "File edits: when the agent must ask before changing files."
        },
        "nebula.effort": {
          "type": "string",
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "nebula.projectsFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder where all your projects live. Empty = `Documents\\Nebula Projects`. New projects are created here and the Open Folder dialog starts here."
        },
        "nebula.autoExecution": {
          "type": "string",
          "default": "agentDecides",
          "enum": [
            "alwaysProceed",
            "agentDecides",
            "requestReview"
          ],
          "enumItemLabels": [
            "Always Proceed",
            "Agent Decides",
            "Request Review"
          ],
          "description": "Terminal commands: Agent Decides runs safe read-only commands and asks before risky ones."
        },
        "nebula.autoFixLints": {
          "type": "boolean",
          "default": true,
          "description": "After the agent changes files, automatically fix errors reported in them."
        },
        "nebula.browserAgent": {
          "type": "boolean",
          "default": false,
          "description": "Let the agent drive a real browser (Playwright MCP) to test web apps. Requires Node.js."
        },
        "nebula.newChatCreatesProject": {
          "type": "boolean",
          "default": true,
          "description": "With no folder open, a new chat gets its own folder in the projects folder."
        },
        "nebula.providers": {
          "type": "array",
          "default": [],
          "description": "Other model providers (added from Settings → Models). API keys are stored separately in secure storage.",
          "items": {
            "type": "object"
          }
        },
        "nebula.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "When your Claude plan limit is reached, continue on this model (\"<provider>::<model>\"). Empty = ask."
        },
        "nebula.ollamaEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local Ollama models in the model menu when Ollama is running."
        },
        "nebula.localContextLength": {
          "type": "number",
          "default": 16384,
          "enum": [
            8192,
            16384,
            32768,
            65536
          ],
          "description": "Context size for local models."
        },
        "nebula.memoryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "The agent keeps notes per project (and global notes) in ~/.nebula/memory and reads them at the start of every conversation."
        },
        "nebula.memoryRecentConversations": {
          "type": "boolean",
          "default": true,
          "description": "New conversations get a short summary of the project's latest conversations."
        },
        "nebula.startupView": {
          "type": "string",
          "default": "recent",
          "enum": [
            "recent",
            "lastConversation"
          ],
          "enumDescriptions": [
            "Start on a new conversation with recent conversations listed",
            "Reopen the last conversation"
          ],
          "description": "What the agent panel shows when Nebula opens."
        }
      }
    },
    "themes": [
      {
        "label": "Nebula Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nebula-dark-color-theme.json"
      },
      {
        "label": "Nebula Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/nebula-midnight-color-theme.json"
      },
      {
        "label": "Nebula Light",
        "uiTheme": "vs",
        "path": "./themes/nebula-light-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Nebula Dark",
      "chat.disableAIFeatures": true,
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.layoutControl.enabled": true,
      "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', Consolas, monospace",
      "editor.fontLigatures": true,
      "editor.smoothScrolling": true,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.smoothScrolling": true,
      "workbench.tree.indent": 14
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "marked": "^18.1.1",
    "dompurify": "^3.4.17"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  }
}
