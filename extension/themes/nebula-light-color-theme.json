    "badge.foreground": "#ffffff",
    "progressBar.background": "#6b5ce7",
    "notifications.background": "#ffffff",
    "notifications.border": "#e3e6ee",
    "menu.background": "#ffffff",
    "menu.selectionBackground": "#6b5ce71f",
    "diffEditor.insertedTextBackground": "#1f9d5522",
    "diffEditor.removedTextBackground": "#d6344522",
    "gitDecoration.modifiedResourceForeground": "#2f7fd8",
    "gitDecoration.untrackedResourceForeground": "#1f9d55",
    "gitDecoration.deletedResourceForeground": "#d63445"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a91a5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#6b4fd8"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#1a8f5a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#c2650a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#1f6fc4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#a35a00"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#b0367a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c2306b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c2650a"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5b6276"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6b4fd8",
        "fontStyle": "bold"
      }
    }
  ]
}