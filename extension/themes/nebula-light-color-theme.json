    "statusBar.noFolderBackground": "#f6f7fb",
    "input.background": "#ffffff",
    "input.border": "#dde0ea",
    "input.placeholderForeground": "#9aa0b2",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#dde0ea",
    "quickInput.background": "#ffffff",
    "quickInputList.focusBackground": "#6b5ce71f",
    "button.background": "#6b5ce7",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#5b4bd6",
    "button.secondaryBackground": "#eceef4",
    "button.secondaryForeground": "#2b3040",
